# Vorlage fuer .env - Kopie anlegen und ausfuellen:
#
#   cp .env.beispiel .env
#
# Die .env selbst gehoert NICHT in die Versionsverwaltung (sie steht in
# .gitignore) - sonst liegt das Passwort auf GitHub.

# Das Passwort des Treffpunkts. Beide Seiten tragen es in SNAPKEY ein
# (Einstellungen -> Treffpunkt).
#
# Wozu es da ist: Ohne Passwort kann jeder, der den Treffpunkt erreicht,
# sich unter JEDER Anschrift anmelden - und damit die echte Gegenstelle
# verdraengen. Mitlesen kann er nicht (die Verschluesselung gilt von
# Geraet zu Geraet), stoeren sehr wohl.
#
# Ein langes, zufaelliges Wort nehmen, kein gemerktes:
#   openssl rand -base64 24
SNAPKEY_TREFFPUNKT_PASS=hier-ein-langes-zufaelliges-passwort-eintragen

# Der Port, auf dem gelauscht wird. Muss mit der Freigabe im Router
# zusammenpassen und mit dem, was in SNAPKEY eingetragen ist.
SNAPKEY_TREFFPUNKT_PORT=41997

# Soll der Treffpunkt den Router selbst um eine Freigabe bitten, damit
# er von aussen erreichbar ist? (1 = ja)
#
# Er probiert NAT-PMP, PCP und UPnP und erneuert die Freigabe, bevor sie
# ablaeuft. Ob das geht, zeigt vorher:  snapkey router
# Klappt es nicht, ist das kein Fehler - dann die Freigabe von Hand im
# Router anlegen.
SNAPKEY_TREFFPUNKT_PORTFREIGABE=1
