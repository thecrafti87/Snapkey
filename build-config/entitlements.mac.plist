<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Die geschuetzte Laufzeit ist Pflicht, sobald beglaubigt werden soll.
    Sie verbietet unter anderem, Programmcode zur Laufzeit zu erzeugen -
    genau das tut aber jede JavaScript-Maschine. Ohne diese drei Rechte
    startet Electron nach dem Signieren nicht mehr.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!--
    SNAPKEY hoert auf Verbindungen und baut selbst welche auf. Ohne beides
    faende kein Geraet das andere.
  -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
</dict>
</plist>
